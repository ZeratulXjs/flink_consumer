# Dummy values only — copy to env/local.env (untracked) and fill in for local runs.
# See CLAUDE.md for the fixed gap this closes: no real secrets checked in.

# RabbitMQ
RMQ_HOST=rabbitmq
RMQ_PORT=5672
RMQ_USER=guest
RMQ_PASSWORD=guest
RMQ_VHOST=/
RMQ_QUEUE=session_submitted

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=session_submitted
KAFKA_DLQ_TOPIC=session_submitted.dlq
KAFKA_CONSUMER_GROUP=flink-consumer-group

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=session_tracker
POSTGRES_USER=session_tracker
POSTGRES_PASSWORD=changeme
